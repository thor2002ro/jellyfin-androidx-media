+
+static void CopyOrBobPlane(const uint8_t *src, int src_stride,
+                           uint8_t *dst, int dst_stride,
+                           int width, int height,
+                           bool interlaced, bool top_field_first) {
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+    if (!interlaced || height == 1) {
+        libyuv::CopyPlane(src, src_stride, dst, dst_stride, width, height);
+        return;
+    }
+
+    if (top_field_first) {
+        const int field_rows = (height + 1) / 2;
+        libyuv::CopyPlane(src, src_stride * 2,
+                          dst, dst_stride * 2,
+                          width, field_rows);
+
+        const int interpolated_rows = (height - 1) / 2;
+        if (interpolated_rows > 0) {
+            libyuv::InterpolatePlane(src, src_stride * 2,
+                                     src + 2 * src_stride, src_stride * 2,
+                                     dst + dst_stride, dst_stride * 2,
+                                     width, interpolated_rows, 128);
+        }
+        if ((height & 1) == 0) {
+            std::memcpy(dst + (height - 1) * dst_stride,
+                        src + (height - 2) * src_stride,
+                        static_cast<size_t>(width));
+        }
+    } else {
+        const int field_rows = height / 2;
+        libyuv::CopyPlane(src + src_stride, src_stride * 2,
+                          dst + dst_stride, dst_stride * 2,
+                          width, field_rows);
+        std::memcpy(dst, src + src_stride, static_cast<size_t>(width));
+
+        const int interpolated_rows = height / 2 - 1;
+        if (interpolated_rows > 0) {
+            libyuv::InterpolatePlane(src + src_stride, src_stride * 2,
+                                     src + 3 * src_stride, src_stride * 2,
+                                     dst + 2 * dst_stride, dst_stride * 2,
+                                     width, interpolated_rows, 128);
+        }
+        if ((height & 1) != 0) {
+            std::memcpy(dst + (height - 1) * dst_stride,
+                        src + (height - 2) * src_stride,
+                        static_cast<size_t>(width));
+        }
+    }
+}
+
+static void CopyOrBobI420(const AVFrame *frame, const I420Buffer &dst) {
+    const bool interlaced = IsInterlaced(frame);
+    const bool top_field_first = IsTopFieldFirst(frame);
+    const int chroma_width = (frame->width + 1) / 2;
+    const int chroma_height = (frame->height + 1) / 2;
+
+    CopyOrBobPlane(frame->data[0], frame->linesize[0],
+                   dst.y, dst.stride_y,
+                   frame->width, frame->height,
+                   interlaced, top_field_first);
+    CopyOrBobPlane(frame->data[1], frame->linesize[1],
+                   dst.u, dst.stride_u,
+                   chroma_width, chroma_height,
+                   interlaced, top_field_first);
+    CopyOrBobPlane(frame->data[2], frame->linesize[2],
+                   dst.v, dst.stride_v,
+                   chroma_width, chroma_height,
+                   interlaced, top_field_first);
+}
+
+static void BobPlaneInPlace(uint8_t *data, int stride,
+                            int width, int height,
+                            bool top_field_first) {
+    if (width <= 0 || height < 2) {
+        return;
+    }
+
+    if (top_field_first) {
+        const int interpolated_rows = (height - 1) / 2;
+        if (interpolated_rows > 0) {
+            libyuv::InterpolatePlane(data, stride * 2,
+                                     data + 2 * stride, stride * 2,
+                                     data + stride, stride * 2,
+                                     width, interpolated_rows, 128);
+        }
+        if ((height & 1) == 0) {
+            std::memcpy(data + (height - 1) * stride,
+                        data + (height - 2) * stride,
+                        static_cast<size_t>(width));
+        }
+    } else {
+        std::memcpy(data, data + stride, static_cast<size_t>(width));
+        const int interpolated_rows = height / 2 - 1;
+        if (interpolated_rows > 0) {
+            libyuv::InterpolatePlane(data + stride, stride * 2,
+                                     data + 3 * stride, stride * 2,
+                                     data + 2 * stride, stride * 2,
+                                     width, interpolated_rows, 128);
+        }
+        if ((height & 1) != 0) {
+            std::memcpy(data + (height - 1) * stride,
+                        data + (height - 2) * stride,
+                        static_cast<size_t>(width));
+        }
+    }
+}
+
+static void BobI420InPlace(const I420Buffer &buffer,
+                           int width, int height,
+                           bool top_field_first) {
+    BobPlaneInPlace(buffer.y, buffer.stride_y,
+                    width, height, top_field_first);
+    BobPlaneInPlace(buffer.u, buffer.stride_u,
+                    (width + 1) / 2, (height + 1) / 2,
+                    top_field_first);
+    BobPlaneInPlace(buffer.v, buffer.stride_v,
+                    (width + 1) / 2, (height + 1) / 2,
+                    top_field_first);
+}
