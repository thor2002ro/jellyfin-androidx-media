+static bool ConvertToI420(SwsContext **sws_context,
+                          const AVFrame *source,
+                          const I420Buffer &destination) {
+    *sws_context = sws_getCachedContext(
+            *sws_context,
+            source->width, source->height,
+            static_cast<AVPixelFormat>(source->format),
+            source->width, source->height,
+            AV_PIX_FMT_YUV420P,
+            SWS_FAST_BILINEAR,
+            nullptr, nullptr, nullptr);
+    if (*sws_context == nullptr) {
+        LOGE("Failed to allocate swsContext.");
+        return false;
+    }
+
+    uint8_t *dst_data[4] = {
+            destination.y, destination.u, destination.v, nullptr};
+    int dst_linesize[4] = {
+            destination.stride_y, destination.stride_u,
+            destination.stride_v, 0};
+    const int result = sws_scale(
+            *sws_context,
+            source->data, source->linesize,
+            0, source->height,
+            dst_data, dst_linesize);
+    if (result != source->height) {
+        if (result < 0) {
+            logError("sws_scale", result);
+        } else {
+            LOGE("sws_scale returned %d rows, expected %d.", result, source->height);
+        }
+        return false;
+    }
+    return true;
