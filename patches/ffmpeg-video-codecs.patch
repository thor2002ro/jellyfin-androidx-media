+void resetDeinterlacer(JniContext *jniContext) {
+    avfilter_graph_free(&jniContext->filterGraph);
+    jniContext->filterSource = nullptr;
+    jniContext->filterSink = nullptr;
+    jniContext->filterWidth = 0;
+    jniContext->filterHeight = 0;
+    jniContext->filterFormat = AV_PIX_FMT_NONE;
+}
+
+int initDeinterlacer(JniContext *jniContext, const AVFrame *frame) {
+    resetDeinterlacer(jniContext);
+    jniContext->filterGraph = avfilter_graph_alloc();
+    if (!jniContext->filterGraph) return AVERROR(ENOMEM);
+
+    char args[256];
+    AVRational aspectRatio = frame->sample_aspect_ratio.num
+            ? frame->sample_aspect_ratio : AVRational{1, 1};
+    snprintf(args, sizeof(args),
+             "video_size=%dx%d:pix_fmt=%d:time_base=1/1000000:pixel_aspect=%d/%d",
+             frame->width, frame->height, frame->format, aspectRatio.num, aspectRatio.den);
+
+    int result = avfilter_graph_create_filter(
+            &jniContext->filterSource, avfilter_get_by_name("buffer"), "in",
+            args, nullptr, jniContext->filterGraph);
+    AVFilterContext *yadif = nullptr;
+    if (result >= 0) {
+        result = avfilter_graph_create_filter(
+                &yadif, avfilter_get_by_name("yadif"), "yadif",
+                "mode=send_frame:parity=auto:deint=interlaced", nullptr,
+                jniContext->filterGraph);
+    }
+    if (result >= 0) {
+        result = avfilter_graph_create_filter(
+                &jniContext->filterSink, avfilter_get_by_name("buffersink"), "out",
+                nullptr, nullptr, jniContext->filterGraph);
+    }
+    if (result >= 0) result = avfilter_link(jniContext->filterSource, 0, yadif, 0);
+    if (result >= 0) result = avfilter_link(yadif, 0, jniContext->filterSink, 0);
+    if (result >= 0) result = avfilter_graph_config(jniContext->filterGraph, nullptr);
+    if (result < 0) {
+        resetDeinterlacer(jniContext);
+        return result;
+    }
+
+    jniContext->filterWidth = frame->width;
+    jniContext->filterHeight = frame->height;
+    jniContext->filterFormat = frame->format;
+    return 0;
+}
+
+AVFrame *deinterlaceFrame(JniContext *jniContext, AVFrame *frame) {
+    bool interlaced = frame->flags & AV_FRAME_FLAG_INTERLACED;
+    if (!jniContext->filterGraph && !interlaced) return frame;
+    if (!jniContext->filterGraph || jniContext->filterWidth != frame->width ||
+        jniContext->filterHeight != frame->height || jniContext->filterFormat != frame->format) {
+        int result = initDeinterlacer(jniContext, frame);
+        if (result < 0) {
+            logError("initDeinterlacer", result);
+            return frame;
+        }
+    }
+
+    int result = av_buffersrc_add_frame_flags(
+            jniContext->filterSource, frame, AV_BUFFERSRC_FLAG_KEEP_REF);
+    if (result < 0) {
+        logError("av_buffersrc_add_frame_flags", result);
+        resetDeinterlacer(jniContext);
+        return frame;
+    }
+
+    AVFrame *filteredFrame = av_frame_alloc();
+    if (!filteredFrame) return frame;
+    result = av_buffersink_get_frame(jniContext->filterSink, filteredFrame);
+    if (result == AVERROR(EAGAIN)) {
+        av_frame_free(&filteredFrame);
+        av_frame_free(&frame);
+        return nullptr;
+    }
+    if (result < 0) {
+        logError("av_buffersink_get_frame", result);
+        av_frame_free(&filteredFrame);
+        resetDeinterlacer(jniContext);
+        return frame;
+    }
+
+    av_frame_free(&frame);
+    return filteredFrame;
+}
