+    const I420Buffer destination = {
+            window_y, window_stride_y,
+            window_u, window_stride_uv,
+            window_v, window_stride_uv};
+
+    const bool write_result =
+            WriteFrameToI420(jniContext, frame, destination,
+                             /* render_thread= */ true);
+    if (!write_result) {
+        // A locked native window cannot be cancelled. Post a valid black frame
+        // instead of exposing partially converted YUV data.
+        ClearYv12Buffer(native_window_buffer);
+    }
+    const int post_result =
+            ANativeWindow_unlockAndPost(jniContext->native_window);
+    if (post_result) {
+        if (jniContext->ShouldLogSurfaceError()) {
+            LOGE("kJniStatusANativeWindowError ANativeWindow_unlockAndPost rst [%d]", post_result);
+        }
+        return surface_error();
     }
 
     return VIDEO_DECODER_SUCCESS;
 }
