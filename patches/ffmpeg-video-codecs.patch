+/** Unit tests for {@link FfmpegLibrary}. */
+@RunWith(AndroidJUnit4.class)
+public final class FfmpegLibraryTest {
+
+  @Test
+  public void getCodecName_usesDolbyVisionBaseLayerAndRejectsContainers() {
+    Format hevcDolbyVision =
+        new Format.Builder()
+            .setSampleMimeType(MimeTypes.VIDEO_DOLBY_VISION)
+            .setCodecs("dvh1.05.05")
+            .build();
+    Format h264DolbyVision =
+        new Format.Builder()
+            .setSampleMimeType(MimeTypes.VIDEO_DOLBY_VISION)
+            .setCodecs("dvav.09.01")
+            .build();
+    Format av1DolbyVision =
+        new Format.Builder()
+            .setSampleMimeType(MimeTypes.VIDEO_DOLBY_VISION)
+            .setCodecs("dav1.10.09")
+            .build();
+
+    assertThat(FfmpegLibrary.getCodecName(hevcDolbyVision)).isEqualTo("hevc");
+    assertThat(FfmpegLibrary.getCodecName(h264DolbyVision)).isEqualTo("h264");
+    assertThat(FfmpegLibrary.getCodecName(av1DolbyVision)).isNull();
