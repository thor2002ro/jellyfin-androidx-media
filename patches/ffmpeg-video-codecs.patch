+void bobDeinterlaceFrame(AVFrame *frame) {
+    if (!(frame->flags & AV_FRAME_FLAG_INTERLACED)) return;
+    int result = av_frame_make_writable(frame);
+    if (result < 0) {
+        logError("av_frame_make_writable", result);
+        return;
+    }
+
+    const int field = (frame->flags & AV_FRAME_FLAG_TOP_FIELD_FIRST) ? 0 : 1;
+    for (int plane = 0; plane < 3; plane++) {
+        const int width = plane ? (frame->width + 1) / 2 : frame->width;
+        const int height = plane ? (frame->height + 1) / 2 : frame->height;
+        const int stride = frame->linesize[plane];
+        libyuv::CopyPlane(frame->data[plane] + field * stride, stride * 2,
+                          frame->data[plane] + (1 - field) * stride, stride * 2,
+                          width, height / 2);
+        if (field && (height & 1)) {
+            memcpy(frame->data[plane] + (height - 1) * stride,
+                   frame->data[plane] + (height - 2) * stride, width);
+        }
+    }
+    frame->flags &= ~(AV_FRAME_FLAG_INTERLACED | AV_FRAME_FLAG_TOP_FIELD_FIRST);
+}
