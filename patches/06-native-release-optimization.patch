+++ b/libraries/decoder_ffmpeg/src/main/jni/CMakeLists.txt
@@ -58,6 +58,16 @@ add_library(ffmpegJNI
             SHARED
             ffmpeg_jni.cc)
 
+if(CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo)$")
+    target_compile_options(ffmpegJNI PRIVATE -O3 -flto=thin)
+    target_link_options(ffmpegJNI PRIVATE -flto=thin)
+    if(ANDROID_ABI STREQUAL "armeabi-v7a")
+        target_compile_options(ffmpegJNI PRIVATE -mfpu=neon)
+        target_compile_options(ffmpegJNI PRIVATE -mthumb)
+        target_link_options(ffmpegJNI PRIVATE -Wl,--no-fatal-warnings)
+    endif()
+endif()
+
 target_link_libraries(ffmpegJNI
                       PRIVATE android
                       PRIVATE swresample
